# Cloudflare Pages response headers.
# The service worker and the page must always be revalidated so a new deploy is picked up.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
# Vite output has content hashes in its file names.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# The engine files keep their names across versions; the service worker refreshes them per deploy.
/engine/*
  Cache-Control: public, max-age=86400
# Every response: no framing by other sites, no MIME sniffing, no device permissions we never use.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; object-src 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
