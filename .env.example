# Firebase settings for this project only (used from M3).
# Copy to .env.local and fill in values. Never commit .env.local.
# These values ship to every browser and are not secrets; data safety
# comes from database.rules.json.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
