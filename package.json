{
  "name": "chess-torus-gamets",
  "private": true,
  "version": "0.0.0",
  "description": "西洋棋網頁遊戲：雙人同機、線上對戰、電腦對手與賽後分析",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run format:check && npm test && npm run build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "firebase": "13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.7"
  }
}
